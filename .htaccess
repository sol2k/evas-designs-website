RewriteEngine On

ErrorDocument 404 /404.html

# Old Diwali home page was replaced by an office-specific page.
RewriteRule ^diwali-decoration-ideas-home-office-gurgaon/?$ /diwali-office-decoration-ideas-gurgaon [R=301,L]

# Root pages are linked/canonicalised without .html; redirect the .html
# URLs to the clean ones so both don't get indexed as separate pages.
RewriteRule ^interior-designer-vasant-kunj-delhi/?$ /building-construction-architect-vasant-kunj-delhi [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(about|services|portfolio|faq|contact|privacy-policy|terms-and-conditions|interior-designer-malviya-nagar-delhi|interior-designer-dlf-phase-3-gurgaon|building-construction-architect-vasant-kunj-delhi)\.html[\s?] [NC]
RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]

# Serve foo.html when /foo (or /foo/) is requested, so clean URLs work
# without a redirect and without touching existing .html links/canonicals.
# Matches only a single bare path segment, so it takes priority over
# Apache's own directory-slash handling when foo/ also exists as a real
# folder (e.g. services.html vs services/interior-design/), and it never
# touches multi-segment paths like /services/interior-design/.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)/?$ $1.html [L]
RewriteRule ^construction-cost-calculator-delhi-gurgaon/?$ /free-construction-cost-calculator-delhi-gurgaon [R=301,L]
